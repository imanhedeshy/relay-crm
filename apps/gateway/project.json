{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gateway/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build --workspace @relaycrm/gateway"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev --workspace @relaycrm/gateway"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test --workspace @relaycrm/gateway"
      }
    }
  }
}
